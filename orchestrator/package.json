{
	"name": "multi-pi",
	"version": "0.1.0",
	"description": "Parent orchestrator over N containerised pi subharnesses, each with its own terminal, settings and model",
	"type": "module",
	"private": true,
	"bin": {
		"multy": "./src/cli/main.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"multy": "node --no-warnings src/cli/main.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --no-warnings --test test/*.test.ts",
		"spike:gate": "bash test/spike/run-gate.sh"
	},
	"dependencies": {
		"yaml": "2.8.1"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.0.0",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
